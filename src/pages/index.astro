      H,
      H,
      TL,
    ],
  ];

  const normalizeAngle = (next, prev) => {
    const delta = (((next - prev) % 360) + 360) % 360;
    return prev + delta;
  };

  const getTimeDigits = () => {
    const now = new Date();
    return [now.getHours(), now.getMinutes(), now.getSeconds()].flatMap((val) =>
      String(val).padStart(2, "0").split("").map(Number)
    );
  };

  const randomAngle = () => Math.floor(Math.random() * 360);

  class ClockManager {
    constructor() {
      console.log("Initializing ClockManager");
      this.clockData = [];
      this.initial = true;
      this.app = document.getElementById("clock-app");
      console.log("Found app element:", this.app);
      this.initializeClocks();
      this.startClock();
    }

    initializeClocks() {
      if (!this.app) {
        console.error("Clock app element not found");
        return;
      }
      const containers = this.app.querySelectorAll("div");
      console.log("Found containers:", containers.length);
      containers.forEach((container, digitIndex) => {
        this.clockData[digitIndex] = [];
        for (let i = 0; i < 24; i++) {
          const clock = document.createElement("div");
          clock.className = "clock";
          clock.style.setProperty("--hour-angle", String(randomAngle()));
          clock.style.setProperty("--minute-angle", String(randomAngle()));
          clock.style.setProperty("--dur", "1");
          container.appendChild(clock);

          this.clockData[digitIndex][i] = {
            element: clock,
            prevH: 0,
            prevM: 0,
          };
        }
      });
    }

    updateClocks() {
      const timeDigits = getTimeDigits();

      timeDigits.forEach((digit, digitIndex) => {
        const digitClocks = digits[digit];
        digitClocks.forEach(({ h, m }, clockIndex) => {
          const clockInfo = this.clockData[digitIndex][clockIndex];
          const hourAngle = normalizeAngle(h, clockInfo.prevH);
          const minuteAngle = normalizeAngle(m, clockInfo.prevM);

          clockInfo.element.style.setProperty(
            "--hour-angle",
            String(this.initial ? randomAngle() : hourAngle)
          );
          clockInfo.element.style.setProperty(
            "--minute-angle",
            String(this.initial ? randomAngle() : minuteAngle)
          );
          clockInfo.element.style.setProperty(
            "--dur",
            String(this.initial ? 1 : 0.4)
          );

          clockInfo.prevH = hourAngle;
          clockInfo.prevM = minuteAngle;
        });
      });
    }

    startClock() {
      setTimeout(() => {
        this.initial = false;
      }, 600);

      const updateTime = () => {
        this.updateClocks();
        const now = Date.now();
        const delay = 1000 - (now % 1000);
        setTimeout(updateTime, delay);
      };

      updateTime();
    }
  }

  // Initialize the clock when the page loads
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      new ClockManager();
    });
  } else {
    // DOM is already loaded
    new ClockManager();
  }
</script>
