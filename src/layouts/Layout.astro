---
import { SITE, buildAbsoluteImageUrl, type PageSEO } from "../data/seo";

interface Props {
  seo?: PageSEO;
}

const { seo = {} } = Astro.props;
const siteOrigin = SITE.origin || Astro.url.origin;
const origin = siteOrigin;
const canonicalUrl = seo.canonicalPath
  ? new URL(seo.canonicalPath, origin).href
  : (SITE.origin ? new URL(Astro.url.pathname + Astro.url.search, SITE.origin).href : Astro.url.href);

const title = seo.title ?? SITE.title;
const description = seo.description ?? SITE.description;
const ogImage = buildAbsoluteImageUrl(seo.image ?? SITE.defaultOgImage, origin);
const robots = seo.noindex ? "noindex, nofollow" : (seo.robots ?? SITE.robots);
const ogType = seo.ogType ?? "website";

const jsonLdWebSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  description: SITE.description,
  url: origin,
  potentialAction: {
    "@type": "ReadAction",
    target: { "@id": canonicalUrl },
  },
};

const jsonLdWebPage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonicalUrl,
  isPartOf: { "@id": `${origin}/#website` },
  about: {
    "@type": "Thing",
    name: "Analog clock grid time display",
  },
};

const structuredData = [
  jsonLdWebSite,
  jsonLdWebPage,
  ...(Array.isArray(seo.structuredData) ? seo.structuredData : seo.structuredData ? [seo.structuredData] : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" id="theme-color" content="#1a1a1a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE.keywords.join(", ")} />
    {SITE.author && <meta name="author" content={SITE.author} />}
    {SITE.copyright && <meta name="copyright" content={SITE.copyright} />}
    <meta name="robots" content={robots} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image:alt" content={SITE.tagline} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE.tagline} />
    {SITE.twitterHandle && <meta name="twitter:site" content={SITE.twitterHandle} />}

    <!-- Locale alternates (if any) -->
    {SITE.localeAlternates.map((locale) => (
      <link rel="alternate" hreflang={locale} href={canonicalUrl} />
    ))}

    <!-- Mobile / format -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="application-name" content={SITE.name} />

    <!-- Extra meta from page -->
    {Object.entries(seo.extraMeta ?? {}).map(([key, value]) => {
      const isProperty = key.startsWith("og:") || key.startsWith("twitter:");
      return isProperty ? (
        <meta property={key} content={value} />
      ) : (
        <meta name={key} content={value} />
      );
    })}

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>

<script is:inline>
  // Dynamic favicon clock functionality
  function updateFavicon() {
    const now = new Date();
    const hours = now.getHours();
    const minutes = now.getMinutes();
    const seconds = now.getSeconds();

    // Calculate angles for clock hands
    const hourAngle = (hours % 12) * 30 + (minutes / 60) * 30; // 30 degrees per hour + minute adjustment
    const minuteAngle = minutes * 6 + (seconds / 60) * 6; // 6 degrees per minute + second adjustment
    const secondAngle = seconds * 6; // 6 degrees per second

    // Convert angles to radians
    const hourRad = ((hourAngle - 90) * Math.PI) / 180;
    const minuteRad = ((minuteAngle - 90) * Math.PI) / 180;
    const secondRad = ((secondAngle - 90) * Math.PI) / 180;

    // Calculate hand positions with different lengths
    // Hour hand: shortest (radius 5), Minute hand: medium (radius 7), Second hand: longest (radius 9)
    const hourX = 16 + 5 * Math.cos(hourRad);
    const hourY = 16 + 5 * Math.sin(hourRad);
    const minuteX = 16 + 7 * Math.cos(minuteRad);
    const minuteY = 16 + 7 * Math.sin(minuteRad);
    const secondX = 16 + 9 * Math.cos(secondRad);
    const secondY = 16 + 9 * Math.sin(secondRad);

    // Create new SVG with updated hand positions
    const svgContent = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
      <circle cx="16" cy="16" r="15" fill="white" stroke="#333" stroke-width="2"/>
      <line x1="16" y1="16" x2="${hourX}" y2="${hourY}" stroke="#333" stroke-width="3" stroke-linecap="round"/>
      <line x1="16" y1="16" x2="${minuteX}" y2="${minuteY}" stroke="#333" stroke-width="2" stroke-linecap="round"/>
      <line x1="16" y1="16" x2="${secondX}" y2="${secondY}" stroke="#ff0000" stroke-width="1" stroke-linecap="round"/>
      <circle cx="16" cy="16" r="1" fill="#333"/>
      <style>
        @media (prefers-color-scheme: dark) {
          circle { fill: #222; stroke: #fff; }
          line { stroke: #fff; }
          line:last-of-type { stroke: #ff4444; }
          circle:last-child { fill: #fff; }
        }
      </style>
    </svg>`;

    // Update favicon
    const favicon = document.querySelector('link[rel="icon"]');
    if (favicon) {
      const blob = new Blob([svgContent], { type: "image/svg+xml" });
      const url = URL.createObjectURL(blob);
      favicon.href = url;

      // Clean up previous URL to prevent memory leaks
      if (favicon.dataset.previousUrl) {
        URL.revokeObjectURL(favicon.dataset.previousUrl);
      }
      favicon.dataset.previousUrl = url;
    }
  }

  // Update favicon immediately and then every second
  updateFavicon();
  setInterval(updateFavicon, 1000);
</script>

<script is:inline>
  // Theme management
  const theme = localStorage.getItem('theme') || 'dark';
  document.documentElement.classList.toggle('dark', theme === 'dark');

  function setThemeColorMeta(isDark) {
    const meta = document.querySelector('meta#theme-color');
    if (meta) {
      // Match CSS variable values for body background in each theme
      meta.setAttribute('content', isDark ? '#1a1a1a' : '#ffffff');
    }
  }

  // Initialize theme-color meta to match current theme
  setThemeColorMeta(theme === 'dark');

  function toggleTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark', !isDark);
    localStorage.setItem('theme', !isDark ? 'dark' : 'light');
    setThemeColorMeta(!isDark);
  }

  // Expose toggleTheme to global for button
  window.toggleTheme = toggleTheme;
</script>

<style is:global>
  :root {
    --bg-color: white;
    --clock-border: white;
    --clock-bg: linear-gradient(225deg, #d0d0d0 10%, white);
    --clock-shadow1: -2px 2px 6px #d0d0d0;
    --clock-shadow2: 2px -2px 6px #ffffff;
    --hand-color: black;
  }

  .dark {
    --bg-color: #1a1a1a;
    --clock-border: #333;
    --clock-bg: linear-gradient(225deg, #333 10%, #1a1a1a);
    --clock-shadow1: -2px 2px 6px #000;
    --clock-shadow2: 2px -2px 6px #333;
    --hand-color: white;
  }

  html {
    padding: 0;
    margin: 0;
    background: var(--bg-color);
    transition: background 0.3s ease;
  }

  body {
    padding: 0;
    margin: 0;
    background: var(--bg-color);
    background-color: var(--bg-color);
    transition: background 0.3s ease;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  .app {
    --clock-size: 2.3vw;
    --gap: calc(var(--clock-size) * 0.05);
    --clock-segment-w: calc(var(--clock-size) * 4 + var(--gap) * 3);
    --clock-segment-h: calc(var(--clock-size) * 6 + var(--gap) * 5);
    font-family: sans-serif;
    text-align: center;
    display: flex;
    gap: var(--gap);
    align-items: center;
    justify-content: center;
    height: 100svh; /* ensure background fills safe viewport on mobile */
    min-height: 100svh;
    padding: 0;
  }

  .app > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
    width: var(--clock-segment-w);
    height: var(--clock-segment-h);
  }

  .app > div:nth-of-type(2n) {
    margin-right: var(--clock-size);
  }

  /* Special spacing for AM/PM segments */
  .app > div:nth-of-type(7) {
    margin-left: calc(var(--clock-size) * 0.5);
  }

  /* Force correct layout for segments 6 and 7 */
  .app > div:nth-of-type(7),
  .app > div:nth-of-type(8) {
    display: flex;
    flex-wrap: wrap;
    width: var(--clock-segment-w) !important;
    height: var(--clock-segment-h) !important;
  }

  .clock {
    --w: 47%;
    --h: 3px;
    --dur: 0.4s;
    position: relative;
    width: var(--clock-size);
    height: var(--clock-size);
    border-radius: 50%;
    flex-shrink: 0;
    border: 2px solid var(--clock-border);
    background: var(--clock-bg);
    box-shadow: var(--clock-shadow1), var(--clock-shadow2);
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .clock::before,
  .clock::after {
    position: absolute;
    content: "";
    top: calc(50% - var(--h) * 0.5);
    left: 50%;
    transform-origin: 0% 50%;
    width: var(--w);
    height: var(--h);
    background: var(--hand-color);
    border-radius: 9999px;
    transition: calc(var(--dur) * 1s) ease-in-out, background 0.3s ease;
    transform: rotate(calc(var(--angle) * 1deg));
  }

  .clock::before {
    --angle: var(--hour-angle);
  }

  .clock::after {
    --angle: var(--minute-angle);
  }

  @media (max-width: 700px) {
    .clock {
      --h: 2px;
      border: 1px solid var(--clock-border);
    }
  }

  @media (max-width: 500px) {
    .clock {
      --h: 1px;
      --w: 50%;
    }
  }
</style>
