<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Clock</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<script is:inline>
  // Dynamic favicon clock functionality
  function updateFavicon() {
    const now = new Date();
    const hours = now.getHours();
    const minutes = now.getMinutes();
    const seconds = now.getSeconds();

    // Calculate angles for clock hands
    const hourAngle = (hours % 12) * 30 + (minutes / 60) * 30; // 30 degrees per hour + minute adjustment
    const minuteAngle = minutes * 6 + (seconds / 60) * 6; // 6 degrees per minute + second adjustment
    const secondAngle = seconds * 6; // 6 degrees per second

    // Convert angles to radians
    const hourRad = ((hourAngle - 90) * Math.PI) / 180;
    const minuteRad = ((minuteAngle - 90) * Math.PI) / 180;
    const secondRad = ((secondAngle - 90) * Math.PI) / 180;

    // Calculate hand positions with different lengths
    // Hour hand: shortest (radius 5), Minute hand: medium (radius 7), Second hand: longest (radius 9)
    const hourX = 16 + 5 * Math.cos(hourRad);
    const hourY = 16 + 5 * Math.sin(hourRad);
    const minuteX = 16 + 7 * Math.cos(minuteRad);
    const minuteY = 16 + 7 * Math.sin(minuteRad);
    const secondX = 16 + 9 * Math.cos(secondRad);
    const secondY = 16 + 9 * Math.sin(secondRad);

    // Create new SVG with updated hand positions
    const svgContent = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
      <circle cx="16" cy="16" r="15" fill="white" stroke="#333" stroke-width="2"/>
      <line x1="16" y1="16" x2="${hourX}" y2="${hourY}" stroke="#333" stroke-width="3" stroke-linecap="round"/>
      <line x1="16" y1="16" x2="${minuteX}" y2="${minuteY}" stroke="#333" stroke-width="2" stroke-linecap="round"/>
      <line x1="16" y1="16" x2="${secondX}" y2="${secondY}" stroke="#ff0000" stroke-width="1" stroke-linecap="round"/>
      <circle cx="16" cy="16" r="1" fill="#333"/>
      <style>
        @media (prefers-color-scheme: dark) {
          circle { fill: #222; stroke: #fff; }
          line { stroke: #fff; }
          line:last-of-type { stroke: #ff4444; }
          circle:last-child { fill: #fff; }
        }
      </style>
    </svg>`;

    // Update favicon
    const favicon = document.querySelector('link[rel="icon"]');
    if (favicon) {
      const blob = new Blob([svgContent], { type: "image/svg+xml" });
      const url = URL.createObjectURL(blob);
      favicon.href = url;

      // Clean up previous URL to prevent memory leaks
      if (favicon.dataset.previousUrl) {
        URL.revokeObjectURL(favicon.dataset.previousUrl);
      }
      favicon.dataset.previousUrl = url;
    }
  }

  // Update favicon immediately and then every second
  updateFavicon();
  setInterval(updateFavicon, 1000);
</script>

<style is:global>
  body {
    padding: 0;
    margin: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  .app {
    --clock-size: 2.3vw;
    --gap: calc(var(--clock-size) * 0.05);
    --clock-segment-w: calc(var(--clock-size) * 4 + var(--gap) * 3);
    --clock-segment-h: calc(var(--clock-size) * 6 + var(--gap) * 5);
    font-family: sans-serif;
    text-align: center;
    display: flex;
    gap: var(--gap);
    align-items: center;
    justify-content: center;
    height: 100vh;
    padding: 0;
  }

  .app > div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
    width: var(--clock-segment-w);
    height: var(--clock-segment-h);
  }

  .app > div:nth-of-type(2n) {
    margin-right: var(--clock-size);
  }

  /* Special spacing for AM/PM segments */
  .app > div:nth-of-type(7) {
    margin-left: calc(var(--clock-size) * 0.5);
  }

  /* Force correct layout for segments 6 and 7 */
  .app > div:nth-of-type(7),
  .app > div:nth-of-type(8) {
    display: flex;
    flex-wrap: wrap;
    width: var(--clock-segment-w) !important;
    height: var(--clock-segment-h) !important;
  }

  .clock {
    --w: 47%;
    --h: 3px;
    --dur: 0.4s;
    position: relative;
    width: var(--clock-size);
    height: var(--clock-size);
    border-radius: 50%;
    flex-shrink: 0;
    border: 2px solid white;
    background: linear-gradient(225deg, #d0d0d0 10%, white);
    box-shadow:
      -2px 2px 6px #d0d0d0,
      2px -2px 6px #ffffff;
  }

  .clock::before,
  .clock::after {
    position: absolute;
    content: "";
    top: calc(50% - var(--h) * 0.5);
    left: 50%;
    transform-origin: 0% 50%;
    width: var(--w);
    height: var(--h);
    background: black;
    border-radius: 9999px;
    transition: calc(var(--dur) * 1s) ease-in-out;
    transform: rotate(calc(var(--angle) * 1deg));
  }

  .clock::before {
    --angle: var(--hour-angle);
  }

  .clock::after {
    --angle: var(--minute-angle);
  }

  @media (max-width: 700px) {
    .clock {
      --h: 2px;
      border: 1px solid white;
    }
  }

  @media (max-width: 500px) {
    .clock {
      --h: 1px;
      --w: 50%;
    }
  }
</style>
